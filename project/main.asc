// Local test main — runs the first test case
// Usage: ./add_rms_norm_bias_custom

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

int main()
{
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t x_0_shape[] = {1, 64};
    TensorInfo x_tensors[] = {{x_0_shape, 2, 1}};
    TensorGroupInfo info_x = {x_tensors, 1};
    int64_t residual_0_shape[] = {1, 64};
    TensorInfo residual_tensors[] = {{residual_0_shape, 2, 1}};
    TensorGroupInfo info_residual = {residual_tensors, 1};
    int64_t gamma_0_shape[] = {64};
    TensorInfo gamma_tensors[] = {{gamma_0_shape, 1, 1}};
    TensorGroupInfo info_gamma = {gamma_tensors, 1};
    int64_t bias_0_shape[] = {64};
    TensorInfo bias_tensors[] = {{bias_0_shape, 1, 1}};
    TensorGroupInfo info_bias = {bias_tensors, 1};
    int64_t output_0_shape[] = {1, 64};
    TensorInfo output_tensors[] = {{output_0_shape, 2, 1}};
    TensorGroupInfo info_output = {output_tensors, 1};

    float epsilon = 1e-05f;

    uint8_t *inputHost_x = nullptr, *inputDevice_x = nullptr;
    uint8_t *inputHost_residual = nullptr, *inputDevice_residual = nullptr;
    uint8_t *inputHost_gamma = nullptr, *inputDevice_gamma = nullptr;
    uint8_t *inputHost_bias = nullptr, *inputDevice_bias = nullptr;

    uint8_t *outputHost_output = nullptr, *outputDevice_output = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x, 128));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x, 128, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x.bin", 128, inputHost_x, 128));
    ACL_CHECK(aclrtMemcpy(inputDevice_x, 128, inputHost_x, 128, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_residual, 128));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_residual, 128, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/residual.bin", 128, inputHost_residual, 128));
    ACL_CHECK(aclrtMemcpy(inputDevice_residual, 128, inputHost_residual, 128, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_gamma, 128));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_gamma, 128, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/gamma.bin", 128, inputHost_gamma, 128));
    ACL_CHECK(aclrtMemcpy(inputDevice_gamma, 128, inputHost_gamma, 128, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_bias, 128));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_bias, 128, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/bias.bin", 128, inputHost_bias, 128));
    ACL_CHECK(aclrtMemcpy(inputDevice_bias, 128, inputHost_bias, 128, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_output, 128));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_output, 128, ACL_MEM_MALLOC_HUGE_FIRST));

    run_kernel((GM_ADDR)inputDevice_x, info_x, (GM_ADDR)inputDevice_residual, info_residual, (GM_ADDR)inputDevice_gamma, info_gamma, (GM_ADDR)inputDevice_bias, info_bias, (GM_ADDR)outputDevice_output, info_output, availableCoreNum, stream, epsilon);
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 3000);
    if (sync_ret_ != 0) { fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_); return 1; }

    ACL_CHECK(aclrtMemcpy(outputHost_output, 128, outputDevice_output, 128, ACL_MEMCPY_DEVICE_TO_HOST));
    FILE_CHECK(WriteFile("./output/output.bin", outputHost_output, 128));

    if (inputDevice_x) aclrtFree(inputDevice_x);
    if (inputHost_x) aclrtFreeHost(inputHost_x);
    if (inputDevice_residual) aclrtFree(inputDevice_residual);
    if (inputHost_residual) aclrtFreeHost(inputHost_residual);
    if (inputDevice_gamma) aclrtFree(inputDevice_gamma);
    if (inputHost_gamma) aclrtFreeHost(inputHost_gamma);
    if (inputDevice_bias) aclrtFree(inputDevice_bias);
    if (inputHost_bias) aclrtFreeHost(inputHost_bias);
    if (outputDevice_output) aclrtFree(outputDevice_output);
    if (outputHost_output) aclrtFreeHost(outputHost_output);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
