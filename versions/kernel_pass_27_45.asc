#include <cmath>
#include <cstdint>
#include "acl/acl.h"
#include "kernel_operator.h"

// CANNJudge's main.asc supplies TensorInfo and TensorGroupInfo before including
// this file. The dtype IDs below belong to that template, not ge::DataType.
namespace arb {
using namespace AscendC;

constexpr uint32_t kChunk = 4096;

template <typename T>
__aicore__ inline void ToFloat(const LocalTensor<float>& dst,
                                const LocalTensor<T>& src, uint32_t count)
{
    Cast(dst, src, RoundMode::CAST_NONE, count);
}

__aicore__ inline void ToFloat(const LocalTensor<float>& dst,
                                const LocalTensor<float>& src, uint32_t count)
{
    Adds(dst, src, 0.0f, count);
}

template <typename T>
__aicore__ inline void FromFloat(const LocalTensor<T>& dst,
                                  const LocalTensor<float>& src, uint32_t count)
{
    Cast(dst, src, RoundMode::CAST_RINT, count);
}

__aicore__ inline void FromFloat(const LocalTensor<float>& dst,
                                  const LocalTensor<float>& src, uint32_t count)
{
    Adds(dst, src, 0.0f, count);
}

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                GM_ADDR bias, GM_ADDR output, uint64_t rows,
                                uint32_t hidden, uint32_t rowsPerCore,
                                uint32_t chunk, float invHidden, float epsilon)
    {
        rows_ = rows;
        hidden_ = hidden;
        rowsPerCore_ = rowsPerCore;
        chunk_ = chunk;
        invHidden_ = invHidden;
        epsilon_ = epsilon;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), rows * hidden);
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual), rows * hidden);
        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma), hidden);
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias), hidden);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output), rows * hidden);

        const uint32_t typedBytes = chunk * sizeof(T);
        const uint32_t floatBytes = chunk * sizeof(float);
        pipe_.InitBuffer(xQ_, 1, typedBytes);
        pipe_.InitBuffer(residualQ_, 1, typedBytes);
        pipe_.InitBuffer(gammaQ_, 1, typedBytes);
        pipe_.InitBuffer(biasQ_, 1, typedBytes);
        pipe_.InitBuffer(outQ_, 1, typedBytes);
        pipe_.InitBuffer(yFloatBuf_, floatBytes);
        pipe_.InitBuffer(squareBuf_, floatBytes);
        pipe_.InitBuffer(reduceWorkBuf_, floatBytes);
        pipe_.InitBuffer(gammaFloatBuf_, floatBytes);
        pipe_.InitBuffer(biasFloatBuf_, floatBytes);
        pipe_.InitBuffer(sumBuf_, 32);
    }

    __aicore__ inline void Process()
    {
        const uint64_t begin = static_cast<uint64_t>(GetBlockIdx()) * rowsPerCore_;
        uint64_t end = begin + rowsPerCore_;
        if (end > rows_) end = rows_;
        for (uint64_t row = begin; row < end; ++row) {
            float sum = 0.0f;
            for (uint32_t col = 0; col < hidden_; col += chunk_) {
                const uint32_t count = Min(chunk_, hidden_ - col);
                LoadAndAdd(row, col, count);
                sum += SquareSum(count);
            }

            auto norm = sumBuf_.Get<float>();
            Duplicate(norm, sum * invHidden_ + epsilon_, 1);
            Sqrt(norm, norm, 1);
            const float invRms = 1.0f / norm.GetValue(0);
            for (uint32_t col = 0; col < hidden_; col += chunk_) {
                const uint32_t count = Min(chunk_, hidden_ - col);
                // The first pass leaves the complete row in UB only when it
                // fits in one chunk. Larger rows are read a second time.
                if (hidden_ > chunk_) LoadAndAdd(row, col, count);
                NormalizeBiasStore(row, col, count, invRms);
            }
        }
    }

private:
    __aicore__ inline uint32_t Min(uint32_t a, uint32_t b) const
    {
        return a < b ? a : b;
    }

    __aicore__ inline void LoadAndAdd(uint64_t row, uint32_t col, uint32_t count)
    {
        auto xLocal = xQ_.AllocTensor<T>();
        auto rLocal = residualQ_.AllocTensor<T>();
        const DataCopyExtParams params{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        const DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        const uint64_t offset = row * hidden_ + col;
        DataCopyPad(xLocal, xGm_[offset], params, pad);
        DataCopyPad(rLocal, residualGm_[offset], params, pad);
        xQ_.EnQue(xLocal);
        residualQ_.EnQue(rLocal);

        xLocal = xQ_.DeQue<T>();
        rLocal = residualQ_.DeQue<T>();
        auto yf = yFloatBuf_.Get<float>();
        auto rf = squareBuf_.Get<float>();
        ToFloat(yf, xLocal, count);
        ToFloat(rf, rLocal, count);
        Add(yf, yf, rf, count);
        xQ_.FreeTensor(xLocal);
        residualQ_.FreeTensor(rLocal);
    }

    __aicore__ inline float SquareSum(uint32_t count)
    {
        auto yf = yFloatBuf_.Get<float>();
        auto square = squareBuf_.Get<float>();
        auto work = reduceWorkBuf_.Get<float>();
        auto result = sumBuf_.Get<float>();
        Mul(square, yf, yf, count);
        ReduceSum(result, square, work, count);
        return result.GetValue(0);
    }

    __aicore__ inline void NormalizeBiasStore(uint64_t row, uint32_t col,
                                               uint32_t count, float invRms)
    {
        auto gLocal = gammaQ_.AllocTensor<T>();
        auto bLocal = biasQ_.AllocTensor<T>();
        const DataCopyExtParams params{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        const DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        DataCopyPad(gLocal, gammaGm_[col], params, pad);
        DataCopyPad(bLocal, biasGm_[col], params, pad);
        gammaQ_.EnQue(gLocal);
        biasQ_.EnQue(bLocal);

        gLocal = gammaQ_.DeQue<T>();
        bLocal = biasQ_.DeQue<T>();
        auto yf = yFloatBuf_.Get<float>();
        auto gf = gammaFloatBuf_.Get<float>();
        auto bf = biasFloatBuf_.Get<float>();
        auto out = outQ_.AllocTensor<T>();
        ToFloat(gf, gLocal, count);
        ToFloat(bf, bLocal, count);
        Muls(yf, yf, invRms, count);
        Mul(yf, yf, gf, count);
        Add(yf, yf, bf, count);
        FromFloat(out, yf, count);
        outQ_.EnQue(out);
        gammaQ_.FreeTensor(gLocal);
        biasQ_.FreeTensor(bLocal);

        out = outQ_.DeQue<T>();
        DataCopyPad(outGm_[row * hidden_ + col], out, params);
        outQ_.FreeTensor(out);
    }

    TPipe pipe_;
    TQue<TPosition::VECIN, 1> xQ_, residualQ_, gammaQ_, biasQ_;
    TQue<TPosition::VECOUT, 1> outQ_;
    TBuf<TPosition::VECCALC> yFloatBuf_, squareBuf_;
    TBuf<TPosition::VECCALC> reduceWorkBuf_, gammaFloatBuf_, biasFloatBuf_, sumBuf_;
    GlobalTensor<T> xGm_, residualGm_, gammaGm_, biasGm_, outGm_;
    uint64_t rows_ = 0;
    uint32_t hidden_ = 0;
    uint32_t rowsPerCore_ = 0;
    uint32_t chunk_ = 0;
    float invHidden_ = 0.0f;
    float epsilon_ = 1.0e-5f;
};

} // namespace arb

extern "C" __global__ __vector__ void add_rms_norm_bias_custom(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint64_t rows, uint32_t hidden, uint32_t rowsPerCore, uint32_t chunk,
    float invHidden, float epsilon, uint32_t dtype)
{
    if (dtype == 0) {
        arb::Kernel<float> op;
        op.Init(x, residual, gamma, bias, output, rows, hidden, rowsPerCore, chunk, invHidden, epsilon);
        op.Process();
    } else if (dtype == 1) {
        arb::Kernel<half> op;
        op.Init(x, residual, gamma, bias, output, rows, hidden, rowsPerCore, chunk, invHidden, epsilon);
        op.Process();
    } else if (dtype == 2) {
        arb::Kernel<bfloat16_t> op;
        op.Init(x, residual, gamma, bias, output, rows, hidden, rowsPerCore, chunk, invHidden, epsilon);
        op.Process();
    }
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    (void)info_residual;
    (void)info_gamma;
    (void)info_bias;
    (void)info_output;
    const TensorInfo& xi = info_x.tensors[0];
    if (xi.numDims < 2) return;
    const uint32_t hidden = static_cast<uint32_t>(xi.shape[xi.numDims - 1]);
    uint64_t rows = 1;
    for (int64_t i = 0; i < xi.numDims - 1; ++i) rows *= xi.shape[i];
    if (rows == 0 || hidden == 0 || xi.dtype < 0 || xi.dtype > 2) return;

    // Neighbouring unaligned rows may share a 32-byte output block. Put all
    // rows of each such block on one core to avoid cross-core write races.
    const uint32_t elementsPerBlock = xi.dtype == 0 ? 8 : 16;
    uint32_t group = elementsPerBlock;
    uint32_t a = hidden, b = elementsPerBlock;
    while (b != 0) { const uint32_t t = a % b; a = b; b = t; }
    group /= a;
    const uint64_t groups = (rows + group - 1) / group;
    uint64_t cores = availableCoreNum > 0 ? static_cast<uint64_t>(availableCoreNum) : 1;
    if (cores > groups) cores = groups;
    const uint64_t groupsPerCore = (groups + cores - 1) / cores;
    const uint32_t rowsPerCore = static_cast<uint32_t>(groupsPerCore * group);
    const uint32_t chunk = hidden < arb::kChunk ? hidden : arb::kChunk;
    const float invHidden = 1.0f / static_cast<float>(hidden);

    add_rms_norm_bias_custom<<<static_cast<uint32_t>(cores), nullptr, stream>>>(
        x, residual, gamma, bias, output, rows, hidden, rowsPerCore,
        chunk, invHidden, epsilon, static_cast<uint32_t>(xi.dtype));
}
