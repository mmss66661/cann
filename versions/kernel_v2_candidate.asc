#include <cmath>
#include <cstdint>
#include "acl/acl.h"
#include "kernel_operator.h"

// CANNJudge's main.asc supplies TensorInfo and TensorGroupInfo before including
// this file. The dtype IDs below belong to that template, not ge::DataType.
namespace arb {
using namespace AscendC;

constexpr uint32_t kChunk = 4096;

template <typename T>
__aicore__ inline void ToFloat(const LocalTensor<float>& dst,
                                const LocalTensor<T>& src, uint32_t count)
{
    Cast(dst, src, RoundMode::CAST_NONE, count);
}

__aicore__ inline void ToFloat(const LocalTensor<float>& dst,
                                const LocalTensor<float>& src, uint32_t count)
{
    Adds(dst, src, 0.0f, count);
}

template <typename T>
__aicore__ inline void FromFloat(const LocalTensor<T>& dst,
                                  const LocalTensor<float>& src, uint32_t count)
{
    Cast(dst, src, RoundMode::CAST_RINT, count);
}

__aicore__ inline void FromFloat(const LocalTensor<float>& dst,
                                  const LocalTensor<float>& src, uint32_t count)
{
    Adds(dst, src, 0.0f, count);
}

template <typename T>
class Kernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma,
                                GM_ADDR bias, GM_ADDR output, uint64_t rows,
                                uint32_t hidden, uint32_t rowsPerCore,
                                uint32_t chunk, float invHidden, float epsilon)
    {
        rows_ = rows;
        hidden_ = hidden;
        rowsPerCore_ = rowsPerCore;
        chunk_ = chunk;
        invHidden_ = invHidden;
        epsilon_ = epsilon;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), rows * hidden);
        residualGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(residual), rows * hidden);
        gammaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma), hidden);
        biasGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(bias), hidden);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output), rows * hidden);

        const uint32_t typedBytes = chunk * sizeof(T);
        const uint32_t floatBytes = chunk * sizeof(float);
        pipe_.InitBuffer(xQ_, 1, typedBytes);
        pipe_.InitBuffer(residualQ_, 1, typedBytes);
        pipe_.InitBuffer(gammaQ_, 1, typedBytes);
        pipe_.InitBuffer(biasQ_, 1, typedBytes);
        pipe_.InitBuffer(outQ_, 1, typedBytes);
        pipe_.InitBuffer(yFloatBuf_, floatBytes);
        pipe_.InitBuffer(squareBuf_, floatBytes);
        pipe_.InitBuffer(reduceWorkBuf_, floatBytes);
        pipe_.InitBuffer(gammaFloatBuf_, floatBytes);
        pipe_.InitBuffer(biasFloatBuf_, floatBytes);
        pipe_.InitBuffer(sumBuf_, 32);
    }

    __aicore__ inline void Process()
    {
        const uint64_t begin = static_cast<uint64_t>(GetBlockIdx()) * rowsPerCore_;
        uint64_t end = begin + rowsPerCore_;
        if (end > rows_) end = rows_;
        for (uint64_t row = begin; row < end; ++row) {
            float sum = 0.0f;
            for (uint32_t col = 0; col < hidden_; col += chunk_) {
                const uint32_t count = Min(chunk_, hidden_ - col);
                LoadAndAdd(row, col, count);
                sum += SquareSum(count);
            }

            auto norm = sumBuf_.Get<float>();
            Duplicate(norm, sum * invHidden_ + epsilon_, 1);
            Sqrt(norm, norm, 1);
            const float invRms = 1.0f / norm.GetValue(0);
            for (uint32_t col = 0; col < hidden_; col += chunk_) {
                const uint32_t count = Min(chunk_, hidden_ - col);
                // The first pass leaves the complete row in UB only when it
                // fits in one chunk. Larger rows are read a second time.
                if (hidden_ > chunk_) LoadAndAdd(row, col, count);
                NormalizeBiasStore(row, col, count, invRms);
            }
        }
    }

private:
    __aicore__ inline uint32_t Min(uint32_t a, uint32_t b) const
    {
        return a < b ? a : b;
    }

    __aicore__ inline void LoadAndAdd(uint64_t row, uint32_t col, uint32_t count)
    {
        auto xLocal = xQ_.AllocTensor<T>();
        auto rLocal = residualQ_.AllocTensor<T>();
        const DataCopyExtParams params{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        const DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        const uint64_t offset = row * hidden_ + col;
        DataCopyPad(xLocal, xGm_[offset], params, pad);
        DataCopyPad(rLocal, residualGm_[offset], params, pad);
        xQ_.EnQue(xLocal);
        residualQ_.EnQue(rLocal);

        xLocal = xQ_.DeQue<T>();
        rLocal = residualQ_.DeQue<T>();
        auto yf = yFloatBuf_.Get<float>();
        auto rf = squareBuf_.Get<float>();
        ToFloat(yf, xLocal, count);
        ToFloat(rf, rLocal, count);
        Add(yf, yf, rf, count);
        xQ_.FreeTensor(xLocal);
        residualQ_.FreeTensor(rLocal);
    }

    __aicore__ inline float SquareSum(uint32_t count)
    {
        auto yf = yFloatBuf_.Get<float>();
        auto square = squareBuf_.Get<float>();
        auto work = reduceWorkBuf_.Get<float>();
        auto result = sumBuf_.Get<float>();
        Mul(square, yf, yf, count);
        ReduceSum(result, square, work, count);
        return result.GetValue(0);
    }

    __aicore__ inline void NormalizeBiasStore(uint64_t row, uint32_t col,
                                               uint32_t count, float invRms)
    {
        auto gLocal = gammaQ_.AllocTensor<T>();
        auto bLocal = biasQ_.AllocTensor<T>();
        const DataCopyExtParams params{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        const DataCopyPadExtParams<T> pad{false, 0, 0, static_cast<T>(0)};
        DataCopyPad(gLocal, gammaGm_[col], params, pad);
        DataCopyPad(bLocal, biasGm_[col], params, pad);
        gammaQ_.EnQue(gLocal);
        biasQ_.EnQue(bLocal);

        gLocal = gammaQ_.DeQue<T>();
        bLocal = biasQ_.DeQue<T>();
        auto yf = yFloatBuf_.Get<float>();
        auto gf = gammaFloatBuf_.Get<float>();
        auto bf = biasFloatBuf_.Get<float>();
        auto out = outQ_.AllocTensor<T>();
        ToFloat(gf, gLocal, count);
        ToFloat(bf, bLocal, count);
        Muls(yf, yf, invRms, count);
        Mul(yf, yf, gf, count);
        Add(yf, yf, bf, count);
        FromFloat(out, yf, count);
        outQ_.EnQue(out);
        gammaQ_.FreeTensor(gLocal);
        biasQ_.FreeTensor(bLocal);

        out = outQ_.DeQue<T>();
        DataCopyPad(outGm_[row * hidden_ + col], out, params);
        outQ_.FreeTensor(out);
    }

    TPipe pipe_;
    TQue<TPosition::VECIN, 1> xQ_, residualQ_, gammaQ_, biasQ_;
    TQue<TPosition::VECOUT, 1> outQ_;
    TBuf<TPosition::VECCALC> yFloatBuf_, squareBuf_;
    TBuf<TPosition::VECCALC> reduceWorkBuf_, gammaFloatBuf_, biasFloatBuf_, sumBuf_;
    GlobalTensor<T> xGm_, residualGm_, gammaGm_, biasGm_, outGm_;
    uint64_t rows_ = 0;
    uint32_t hidden_ = 0;
    uint32_t rowsPerCore_ = 0;
    uint32_t chunk_ = 0;
    float invHidden_ = 0.0f;
    float epsilon_ = 1.0e-5f;
};

// Fast paths use only aligned rows. The original kernel remains the fallback.
template <typename T>
__aicore__ inline void AddInputs(const LocalTensor<float>& y,
    const LocalTensor<float>& scratch, const LocalTensor<T>& x,
    const LocalTensor<T>& r, uint32_t n)
{
    ToFloat(y, x, n);
    ToFloat(scratch, r, n);
    Add(y, y, scratch, n);
}

__aicore__ inline void AddInputs(const LocalTensor<float>& y,
    const LocalTensor<float>& scratch, const LocalTensor<float>& x,
    const LocalTensor<float>& r, uint32_t n)
{
    Add(y, x, r, n);
}

// Many short rows per DMA; no vector-to-scalar reads in the compute loop.
template <typename T>
class BatchKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR o, uint64_t rows, uint32_t d, uint32_t rowsPerCore,
        float invD, float eps)
    {
        d_ = d;
        invD_ = invD;
        eps_ = eps;
        begin_ = static_cast<uint64_t>(GetBlockIdx()) * rowsPerCore;
        end_ = begin_ + rowsPerCore;
        if (end_ > rows) end_ = rows;
        const uint32_t capacity = sizeof(T) == 4 ? 4096 : 8192;
        tileRows_ = capacity / d;
        const uint32_t tile = tileRows_ * d;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), rows * d);
        r_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(r), rows * d);
        g_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(g), d);
        b_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b), d);
        o_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(o), rows * d);
        pipe_.InitBuffer(xq_, 2, tile * sizeof(T));
        pipe_.InitBuffer(rq_, 2, tile * sizeof(T));
        pipe_.InitBuffer(oq_, 2, tile * sizeof(T));
        pipe_.InitBuffer(ybuf_, tile * 4);
        pipe_.InitBuffer(sqbuf_, tile * 4);
        pipe_.InitBuffer(gbuf_, d * 4);
        pipe_.InitBuffer(bbuf_, d * 4);
        const uint32_t paddedRows = (tileRows_ + 7) / 8 * 8;
        pipe_.InitBuffer(normbuf_, paddedRows * 4);
        pipe_.InitBuffer(brbuf_, paddedRows * 32);
    }

    __aicore__ inline void Process()
    {
        if (begin_ >= end_) return;
        auto gx = xq_.AllocTensor<T>();
        auto bx = rq_.AllocTensor<T>();
        DataCopy(gx, g_, d_);
        DataCopy(bx, b_, d_);
        xq_.EnQue(gx);
        rq_.EnQue(bx);
        gx = xq_.DeQue<T>();
        bx = rq_.DeQue<T>();
        ToFloat(gbuf_.Get<float>(), gx, d_);
        ToFloat(bbuf_.Get<float>(), bx, d_);
        xq_.FreeTensor(gx);
        rq_.FreeTensor(bx);
        CopyIn(begin_, Count(begin_));
        for (uint64_t row = begin_; row < end_; row += tileRows_) {
            const uint64_t next = row + tileRows_;
            if (next < end_) CopyIn(next, Count(next));
            Compute(Count(row));
            auto out = oq_.DeQue<T>();
            DataCopy(o_[row * d_], out, Count(row) * d_);
            oq_.FreeTensor(out);
        }
    }

private:
    __aicore__ inline uint32_t Count(uint64_t row) const
    {
        return end_ - row < tileRows_ ? static_cast<uint32_t>(end_ - row) : tileRows_;
    }

    __aicore__ inline void CopyIn(uint64_t row, uint32_t nrows)
    {
        auto x = xq_.AllocTensor<T>();
        auto r = rq_.AllocTensor<T>();
        DataCopy(x, x_[row * d_], nrows * d_);
        DataCopy(r, r_[row * d_], nrows * d_);
        xq_.EnQue(x);
        rq_.EnQue(r);
    }

    __aicore__ inline void Compute(uint32_t nrows)
    {
        auto x = xq_.DeQue<T>();
        auto r = rq_.DeQue<T>();
        auto y = ybuf_.Get<float>();
        auto sq = sqbuf_.Get<float>();
        auto norm = normbuf_.Get<float>();
        auto br = brbuf_.Get<float>();
        auto g = gbuf_.Get<float>();
        auto b = bbuf_.Get<float>();
        const uint32_t n = nrows * d_;
        AddInputs(y, sq, x, r, n);
        xq_.FreeTensor(x);
        rq_.FreeTensor(r);
        Mul(sq, y, y, n);
        const uint8_t stride = static_cast<uint8_t>(d_ / 8);
        const uint8_t repeats = static_cast<uint8_t>(nrows);
        const BinaryRepeatParams fold{1, 1, 1, stride, stride, stride};
        // Fold columns separated by 64, then sum each row's remaining 64 lanes.
        for (uint32_t c = 64; c < d_; c += 64) {
            Add(sq, sq, sq[c], uint64_t(64), repeats, fold);
        }
        Duplicate(norm, 1.0f, (nrows + 7) / 8 * 8);
        WholeReduceSum(norm, sq, 64, repeats, 1, 1, stride);
        Muls(norm, norm, invD_, nrows);
        Adds(norm, norm, eps_, nrows);
        Sqrt(norm, norm, nrows);
        Brcb(br, norm, static_cast<uint8_t>((nrows + 7) / 8), {1, 8});
        const BinaryRepeatParams rowNorm{1, 1, 0, stride, stride, 1};
        const BinaryRepeatParams channel{1, 1, 1, stride, stride, 0};
        for (uint32_t c = 0; c < d_; c += 64) {
            Div(y[c], y[c], br, uint64_t(64), repeats, rowNorm);
            Mul(y[c], y[c], g[c], uint64_t(64), repeats, channel);
            Add(y[c], y[c], b[c], uint64_t(64), repeats, channel);
        }
        auto out = oq_.AllocTensor<T>();
        FromFloat(out, y, n);
        oq_.EnQue(out);
    }

    TPipe pipe_;
    TQue<TPosition::VECIN, 2> xq_, rq_;
    TQue<TPosition::VECOUT, 2> oq_;
    TBuf<TPosition::VECCALC> ybuf_, sqbuf_, gbuf_, bbuf_, normbuf_, brbuf_;
    GlobalTensor<T> x_, r_, g_, b_, o_;
    uint64_t begin_, end_;
    uint32_t d_, tileRows_;
    float invD_, eps_;
};

// Retain the complete FP32 residual sum, including D=32768, in UB.
// Parameter caches are reused across rows whenever the whole row fits.
template <typename T>
class RetainedKernel {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
        GM_ADDR o, uint64_t rows, uint32_t d, uint32_t rowsPerCore,
        float invD, float eps)
    {
        d_ = d;
        invD_ = invD;
        eps_ = eps;
        begin_ = static_cast<uint64_t>(GetBlockIdx()) * rowsPerCore;
        end_ = begin_ + rowsPerCore;
        if (end_ > rows) end_ = rows;
        const uint32_t cacheLimit = sizeof(T) == 4 ? 6144 : 8192;
        chunk_ = d <= cacheLimit ? d : 2048;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), rows * d);
        r_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(r), rows * d);
        g_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(g), d);
        b_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(b), d);
        o_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(o), rows * d);
        pipe_.InitBuffer(xq_, 1, chunk_ * sizeof(T));
        pipe_.InitBuffer(rq_, 1, chunk_ * sizeof(T));
        pipe_.InitBuffer(oq_, 1, chunk_ * sizeof(T));
        pipe_.InitBuffer(ybuf_, d * 4);
        pipe_.InitBuffer(sqbuf_, chunk_ * 4);
        pipe_.InitBuffer(gbuf_, chunk_ * 4);
        pipe_.InitBuffer(bbuf_, chunk_ * 4);
        pipe_.InitBuffer(partbuf_, 2048);
        pipe_.InitBuffer(workbuf_, 2048);
        pipe_.InitBuffer(normbuf_, 32);
        pipe_.InitBuffer(brbuf_, 256);
    }

    __aicore__ inline void Process()
    {
        if (begin_ >= end_) return;
        if (chunk_ == d_) LoadParams(0, d_);
        auto y = ybuf_.Get<float>();
        auto sq = sqbuf_.Get<float>();
        auto parts = partbuf_.Get<float>();
        auto norm = normbuf_.Get<float>();
        auto br = brbuf_.Get<float>();
        for (uint64_t row = begin_; row < end_; ++row) {
            for (uint32_t c = 0; c < d_; c += chunk_) {
                const uint32_t n = Count(c);
                auto x = xq_.AllocTensor<T>();
                auto r = rq_.AllocTensor<T>();
                DataCopy(x, x_[row * d_ + c], n);
                DataCopy(r, r_[row * d_ + c], n);
                xq_.EnQue(x);
                rq_.EnQue(r);
                x = xq_.DeQue<T>();
                r = rq_.DeQue<T>();
                AddInputs(y[c], sq, x, r, n);
                xq_.FreeTensor(x);
                rq_.FreeTensor(r);
                Mul(sq, y[c], y[c], n);
                WholeReduceSum(parts[c / 64], sq, 64, n / 64, 1, 1, 8);
            }
            Duplicate(norm, 1.0f, 8);
            ReduceSum(norm, parts, workbuf_.Get<float>(), d_ / 64);
            Muls(norm, norm, invD_, 1);
            Adds(norm, norm, eps_, 1);
            Sqrt(norm, norm, 1);
            Brcb(br, norm, 1, {1, 8});
            for (uint32_t c = 0; c < d_; c += chunk_) {
                const uint32_t n = Count(c);
                if (chunk_ != d_) LoadParams(c, n);
                Div(y[c], y[c], br, uint64_t(64), static_cast<uint8_t>(n / 64),
                    {1, 1, 0, 8, 8, 0});
                Mul(y[c], y[c], gbuf_.Get<float>(), n);
                Add(y[c], y[c], bbuf_.Get<float>(), n);
                auto out = oq_.AllocTensor<T>();
                FromFloat(out, y[c], n);
                oq_.EnQue(out);
                out = oq_.DeQue<T>();
                DataCopy(o_[row * d_ + c], out, n);
                oq_.FreeTensor(out);
            }
        }
    }

private:
    __aicore__ inline uint32_t Count(uint32_t c) const
    {
        return d_ - c < chunk_ ? d_ - c : chunk_;
    }

    __aicore__ inline void LoadParams(uint32_t c, uint32_t n)
    {
        auto g = xq_.AllocTensor<T>();
        auto b = rq_.AllocTensor<T>();
        DataCopy(g, g_[c], n);
        DataCopy(b, b_[c], n);
        xq_.EnQue(g);
        rq_.EnQue(b);
        g = xq_.DeQue<T>();
        b = rq_.DeQue<T>();
        ToFloat(gbuf_.Get<float>(), g, n);
        ToFloat(bbuf_.Get<float>(), b, n);
        xq_.FreeTensor(g);
        rq_.FreeTensor(b);
    }

    TPipe pipe_;
    TQue<TPosition::VECIN, 1> xq_, rq_;
    TQue<TPosition::VECOUT, 1> oq_;
    TBuf<TPosition::VECCALC> ybuf_, sqbuf_, gbuf_, bbuf_;
    TBuf<TPosition::VECCALC> partbuf_, workbuf_, normbuf_, brbuf_;
    GlobalTensor<T> x_, r_, g_, b_, o_;
    uint64_t begin_, end_;
    uint32_t d_, chunk_;
    float invD_, eps_;
};

template <typename T>
__aicore__ inline void Dispatch(GM_ADDR x, GM_ADDR r, GM_ADDR g, GM_ADDR b,
    GM_ADDR o, uint64_t rows, uint32_t d, uint32_t rowsPerCore,
    uint32_t chunk, float invD, float eps)
{
    if (d % 64 == 0 && d <= 1024) {
        BatchKernel<T> op;
        op.Init(x, r, g, b, o, rows, d, rowsPerCore, invD, eps);
        op.Process();
    } else if (d % 64 == 0 && d <= 32768) {
        RetainedKernel<T> op;
        op.Init(x, r, g, b, o, rows, d, rowsPerCore, invD, eps);
        op.Process();
    } else {
        Kernel<T> op;
        op.Init(x, r, g, b, o, rows, d, rowsPerCore, chunk, invD, eps);
        op.Process();
    }
}

} // namespace arb

extern "C" __global__ __vector__ void add_rms_norm_bias_custom(
    GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR bias, GM_ADDR output,
    uint64_t rows, uint32_t hidden, uint32_t rowsPerCore, uint32_t chunk,
    float invHidden, float epsilon, uint32_t dtype)
{
    if (dtype == 0) {
        arb::Dispatch<float>(x, residual, gamma, bias, output, rows, hidden,
            rowsPerCore, chunk, invHidden, epsilon);
    } else if (dtype == 1) {
        arb::Dispatch<half>(x, residual, gamma, bias, output, rows, hidden,
            rowsPerCore, chunk, invHidden, epsilon);
    } else if (dtype == 2) {
        arb::Dispatch<bfloat16_t>(x, residual, gamma, bias, output, rows, hidden,
            rowsPerCore, chunk, invHidden, epsilon);
    }
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR residual, const TensorGroupInfo& info_residual,
    GM_ADDR gamma, const TensorGroupInfo& info_gamma,
    GM_ADDR bias, const TensorGroupInfo& info_bias,
    GM_ADDR output, const TensorGroupInfo& info_output,
    int64_t availableCoreNum, aclrtStream stream, float epsilon)
{
    (void)info_residual;
    (void)info_gamma;
    (void)info_bias;
    (void)info_output;
    const TensorInfo& xi = info_x.tensors[0];
    if (xi.numDims < 2) return;
    const uint32_t hidden = static_cast<uint32_t>(xi.shape[xi.numDims - 1]);
    uint64_t rows = 1;
    for (int64_t i = 0; i < xi.numDims - 1; ++i) rows *= xi.shape[i];
    if (rows == 0 || hidden == 0 || xi.dtype < 0 || xi.dtype > 2) return;

    // Neighbouring unaligned rows may share a 32-byte output block. Put all
    // rows of each such block on one core to avoid cross-core write races.
    const uint32_t elementsPerBlock = xi.dtype == 0 ? 8 : 16;
    uint32_t group = elementsPerBlock;
    uint32_t a = hidden, b = elementsPerBlock;
    while (b != 0) { const uint32_t t = a % b; a = b; b = t; }
    group /= a;
    const uint64_t groups = (rows + group - 1) / group;
    uint64_t cores = availableCoreNum > 0 ? static_cast<uint64_t>(availableCoreNum) : 1;
    if (cores > groups) cores = groups;
    const uint64_t groupsPerCore = (groups + cores - 1) / cores;
    const uint32_t rowsPerCore = static_cast<uint32_t>(groupsPerCore * group);
    const uint32_t chunk = hidden < arb::kChunk ? hidden : arb::kChunk;
    const float invHidden = 1.0f / static_cast<float>(hidden);

    add_rms_norm_bias_custom<<<static_cast<uint32_t>(cores), nullptr, stream>>>(
        x, residual, gamma, bias, output, rows, hidden, rowsPerCore,
        chunk, invHidden, epsilon, static_cast<uint32_t>(xi.dtype));
}
